# ===================================================================
# Application
# ===================================================================
SERVER_PORT=8082

# ===================================================================
# PostgreSQL
# ===================================================================
DB_HOST=localhost
DB_PORT=5430
DB_NAME=auth_db
DB_USERNAME=user
DB_PASSWORD=password

# ===================================================================
# Kafka
# ===================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===================================================================
# Outbox Relay
# ===================================================================
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# ===================================================================
# File Storage
# ===================================================================
STORAGE_ROOT=./uploads

# ===================================================================
# Auth & Security
# ===================================================================
APP_AUTO_CONFIRM_EMAIL=false
APP_EMAIL_ENABLED=true
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=3
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_ENCRYPTION_PASSWORD=Rally@OtpKey2026!Sec
OTP_ENCRYPTION_SALT=41b0bf0fbeeb24a5022dc25ead1b5009
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=64
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ===================================================================
# JWT Keys (override in production!)
# ===================================================================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ===================================================================
# Logging
# ===================================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_RALLY=DEBUG
LOGGING_LEVEL_HIBERNATE=WARN
LOGGING_LEVEL_KAFKA=WARN
LOGGING_LEVEL_KAFKA_CONSUMER=OFF
LOGGING_LEVEL_KAFKA_PRODUCER=OFF
LOGGING_LEVEL_SPRING_KAFKA=WARN
LOGGING_LEVEL_SPRING_KAFKA_LISTENER=WARN
LOGGING_LEVEL_SPRING=WARN
LOGGING_LEVEL_SPRING_BOOT=WARN

# ===================================================================
# Observability
# ===================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MANAGEMENT_HEALTH_SHOW_DETAILS=always

# ===================================================================
# Logging (Loki)
# ===================================================================
LOKI_URL=http://localhost:3100/loki/api/v1/push
