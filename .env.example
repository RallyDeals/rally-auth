# =====================================================================
# rally-auth environment template
# Copy to .env and adjust. Values below are the same safe DEV defaults
# baked into application.properties (verify via `./mvnw spring-boot:run`
# or Docker). ALL values must be overridden in non-local environments.
# =====================================================================

# --- Server ---
SERVER_PORT=8082

# --- PostgreSQL ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/auth_db
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Outbox relay ---
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# OTP encryption (Encryptors requires the salt to be valid hex, even length).
OTP_ENCRYPTION_PASSWORD=Rally@OtpKey2026!Sec
OTP_ENCRYPTION_SALT=41b0bf0fbeeb24a5022dc25ead1b5009

# --- Auth / sessions ---
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
APP_AUTO_CONFIRM_EMAIL=false
APP_EMAIL_ENABLED=true

# --- Password policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=64
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# --- JWT (DEV ONLY defaults; override in production) ---
# APP_SECURITY_JWT_PRIVATEKEY = base64 of PKCS#8 DER (no PEM armor)
# APP_SECURITY_JWT_PUBLICKEY  = PEM armored public key
#APP_SECURITY_JWT_PRIVATEKEY=
#APP_SECURITY_JWT_PUBLICKEY=